# 이 파일을 .env 로 복사한 뒤 값을 채운다. .env 는 .gitignore 대상이라 커밋되지 않는다.
# 실제 키를 이 .env.example 에 적지 말 것.

# 이미지 생성 백엔드 (gemini 권장)
IMAGE_BACKEND=gemini

# Google AI Studio에서 발급한 키 (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# (선택) 기본 그림 모델 — 비워 두면 gemini-nano-banana-2.1
# GEMINI_MODEL=gemini-nano-banana-2.1

# (선택) 수정 요청 시 프롬프트를 고치는 모델 — 비워 두면 gemini-3.8-flash
# GEMINI_REVISION_MODEL=gemini-3.8-flash
